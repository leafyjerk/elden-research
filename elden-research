def read_config():
    try:
        return dict(re.findall(r"^(ER_[A-Z_]+)=(.*)$", CONFIG.read_text(), re.M))
    except OSError:
        return {}


def set_config(**values):
    """Changes KEY=value lines in place (comments and other keys stay as they are)."""
    text = CONFIG.read_text()
    for k, v in values.items():
        text, n = re.subn(rf"^{k}=.*$", f"{k}={v}", text, flags=re.M)
        if not n:
            text += f"{k}={v}\n"
    CONFIG.write_text(text)


# --- Steam -------------------------------------------------------------------------------

def vdf(text):
    """Parses Valve's KeyValues text format into nested dicts."""
    root = cur = {}
    stack, key = [], None
    for s, brace in re.findall(r'"((?:[^"\\]|\\.)*)"|([{}])', text):
        if brace == "{":
            new = {}
            cur[key or ""] = new
            stack.append(cur)
            cur, key = new, None
        elif brace == "}":
            cur, key = (stack.pop() if stack else root), None
        elif key is None:
            key = s
        else:
            cur[key] = s.replace('\\"', '"').replace("\\\\", "\\")
            key = None
    return root


def vget(d, *path):
    for p in path:
        if not isinstance(d, dict):
            return None
        d = next((v for k, v in d.items() if k.lower() == p.lower()), None)
    return d


def library_dirs():
    dirs = [STEAM]
    try:
        lf = vdf((STEAM / "steamapps/libraryfolders.vdf").read_text(errors="replace"))
        for v in (vget(lf, "libraryfolders") or {}).values():
            if isinstance(v, dict) and v.get("path"):
                dirs.append(Path(v["path"]))
    except OSError:
        pass
    return list(dict.fromkeys(dirs))


def game_library():
    return next((d for d in library_dirs() if (d / f"steamapps/appmanifest_{APPID}.acf").exists()), None)


def steam_settings():
    """What Steam has saved for Elden Ring: (compat tool name, launch options). Steam
    writes these files when it exits, so a change made in the client shows up after that."""
    tool = opts = None
    try:
        cfg = vdf((STEAM / "config/config.vdf").read_text(errors="replace"))
        m = vget(cfg, "InstallConfigStore", "Software", "Valve", "Steam", "CompatToolMapping", APPID)
        tool = vget(m, "name") if isinstance(m, dict) else None
    except OSError:
        pass
    configs = sorted(STEAM.glob("userdata/*/config/localconfig.vdf"), key=lambda p: p.stat().st_mtime, reverse=True)
    for lc in configs:
        apps = vget(vdf(lc.read_text(errors="replace")), "UserLocalConfigStore", "Software", "Valve", "Steam", "apps")
        app = vget(apps, APPID)
        if isinstance(app, dict):
            opts = vget(app, "LaunchOptions") or ""
            break
    return tool, opts


def launch_line():
    return f'"{LAUNCHER}" %command%'


def steam_check(print_it=True):
    tool, opts = steam_settings()
    results = []
    if tool == TOOL_NAME:
        results.append(("ok", "Compatibility tool", tool_display_name()))
    elif tool:
        results.append(("warn", "Compatibility tool", f"{tool} (not the patched one: pick {tool_display_name()})"))
    else:
        results.append(("warn", "Compatibility tool", "not set yet (or Steam hasn't saved it: it saves when it exits)"))
    if opts and str(LAUNCHER) in opts and "%command%" in opts:
        extra = opts.replace(launch_line(), "").replace(str(LAUNCHER), "").replace("%command%", "").strip(' "')
        results.append(("ok", "Launch options", "er-launch.sh" + (f" (+ {extra})" if extra else "")))
    elif opts and "er-launch.sh" in opts:
        results.append(("warn", "Launch options", "uses an older er-launch.sh: " + opts))
    else:
        results.append(("warn", "Launch options", "not set yet" + (f" (now: {opts})" if opts else "")))
    if print_it:
        for r in results:
            item(*r)
    return all(r[0] == "ok" for r in results)


