def build_parse(line, status):
    m = re.match(r"=== \S+ (\d)/7 (.*)", line)
    if m:
        return f"{bar(int(m[1]) / 7, 12)} {m[1]}/7 {m[2]}"
    head = status.split("  ·  ")[0] if "/7 " in status else status
    return f"{head}  ·  {dim(line.strip()[:60])}"


