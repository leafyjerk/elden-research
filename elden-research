def run_qualify(pace, max_mhz):
    """Runs er-smu qualify as root and draws its progress. Returns the final state."""
    burn = DATA / "bin/er-burn"
    burn.parent.mkdir(parents=True, exist_ok=True)
    r = run(["gcc", "-O3", "-march=native", "-pthread", "-o", str(burn), str(LIB / "er-burn.c")])
    if r.returncode:
        say("fail", "Couldn't build the load generator (gcc):", r.stderr.strip()[:200])
        return None
    pace_secs = smu_module().PACES[pace]
    cmd = ["sudo", sys.executable, "-u", str(LIB / "er-smu.py"), "qualify", "--json", "--pace", pace,
           "--max", str(max_mhz), "--burn", str(burn)]
    p = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    total = elapsed_done = 0
    phase_secs, t0, i = 0, time.monotonic(), 0
    try:
        for line in p.stdout:
            try:
                ev = json.loads(line)
            except ValueError:
                live_done()
                print("    " + dim(line.rstrip()))
                continue
            kind = ev.pop("ev")
            if kind == "crash_found":
                live_done()
                say("warn", f"The last OC test didn't finish: the machine froze or rebooted at {ev['mhz']} MHz.",
                    "That step counts as failed; only lower steps are tested.")
            elif kind == "plan":
                total = pace_secs["base"] + len(ev["steps"]) * (ev["cores"] * pace_secs["core"] + pace_secs["game"]) \
                    + pace_secs["soak"]
                say("info", f"Steps: stock baseline → {' → '.join(f'{f} MHz' for f in ev['steps']) or 'none'}"
                            f"{' → soak' if pace_secs['soak'] else ''}",
                    f"~{round(total / 60)} min, {ev['cores']} cores, game-like load on "
                    f"{ev['main']} / {ev['rest']} / {ev['gx']}")
            elif kind == "phase":
                elapsed_done += phase_secs
                phase_secs = ev["secs"]
            elif kind == "sample":
                frac = min(1, (elapsed_done + ev["t"]) / total) if total else 0
                temp = ev["tctl"]
                tcol = green if temp < 80 else yellow if temp < 85 else red
                live(f"  {amber(SPIN[i % len(SPIN)])} {bar(frac, 16)} {round(100 * frac):3}%  {ev['phase']:<28} "
                     f"{ev['t']:3}/{ev['secs']} s  {ev['mhz']} MHz  {ev['mv']} mV  {tcol(f'{temp} °C')}")
                i += 1
            elif kind == "step":
                live_done()
                detail = f"scale {ev['scale']} · peak {ev['peak_mv']} mV · {ev['peak_t']} °C"
                say("ok" if ev["ok"] else "fail", f"{ev['mhz']} MHz " + ("passed" if ev["ok"] else f"failed: {ev['reason']}"),
                    detail)
            elif kind == "soak":
                live_done()
                say("ok" if ev["ok"] else "fail", f"{ev['mhz']} MHz soak " + ("passed" if ev["ok"] else
                                                                               f"failed: {ev['reason'] or 'errors/heat'}"),
                    f"peak {ev['peak_t']} °C, {ev['errors']} wrong results")
            elif kind == "info":
                live_done()
                say("info", ev["msg"])
            elif kind == "done":
                live_done()
                say("ok" if ev["recommended"] else "warn", f"Result: {ev['result']}",
                    f"total {mmss(time.monotonic() - t0)}")
            elif kind == "aborted":
                live_done()
                say("warn", ev["msg"])
    except KeyboardInterrupt:
        live_done()
        say("warn", "Stopping the test (back to stock clocks)...")
        p.send_signal(signal.SIGINT)  # sudo passes it on to er-smu, which goes back to stock
        p.wait()
    p.wait()
    return oc_state()


