def smu_module():
    """lib/er-smu.py as a module, for its topology helpers (they only read sysfs)."""
    import importlib.util
    spec = importlib.util.spec_from_file_location("er_smu", LIB / "er-smu.py")
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


