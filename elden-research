# command -> package (pacman), by feature
PACKAGES = {
    "run": {"scxctl": "scx-tools", "scx_loader": "scx-scheds", "mangohud": "mangohud"},
    "oc": {"gcc": "gcc"},
    "proton": {"git": "git", "clang": "clang", "ld.lld": "lld", "bison": "bison", "flex": "flex",
               "perl": "perl", "curl": "curl", "make": "base-devel", "autoreconf": "base-devel",
               "objdump": "binutils"},
}


def missing_packages(*features):
    return sorted({pkg for f in features for cmd, pkg in PACKAGES[f].items() if not shutil.which(cmd)})


def preflight():
    """Returns [(level, label, detail)]. Changes nothing."""
    r = []
    cpu = open("/proc/cpuinfo").read()
    model = re.search(r"^model name\s*: (.*)$", cpu, re.M)
    model = model[1] if model else "unknown"
    n = os.cpu_count()
    bios = Path("/sys/class/dmi/id/bios_version")
    bios = bios.read_text().strip() if bios.exists() else "?"
    if "BC-250" not in model:
        r.append(("fail", "Hardware", f"{model}: this tool is for the AMD BC-250 only"))
    elif n >= 16:
        r.append(("ok", "Hardware", f"AMD BC-250 · 8 cores / {n} threads (unlocked) · BIOS {bios}"))
    else:
        r.append(("warn", "Hardware", f"AMD BC-250 · {n // 2} cores: works, but the layout is untested with "
                                      "6 cores, and unlocking 8 gave ~+3 FPS (README → 8 cores)"))
    if "BC-250" in model and not re.match(r"P[35]\.", bios):
        r.append(("warn", "BIOS", f"{bios}: the OC code is known to work on P3.00 and P5.00"))
    osr = dict(re.findall(r'^(\w+)="?([^"\n]*)"?$', Path("/etc/os-release").read_text(), re.M))
    kernel = os.uname().release
    if osr.get("ID") == "cachyos":
        r.append(("ok", "OS", f"CachyOS · kernel {kernel}"))
    elif "arch" in (osr.get("ID", "") + osr.get("ID_LIKE", "")):
        r.append(("warn", "OS", f"{osr.get('NAME', '?')}: Arch-based but not CachyOS (untested)"))
    else:
        r.append(("fail", "OS", f"{osr.get('NAME', '?')}: needs CachyOS (pacman, proton-cachyos-slr)"))
    if Path("/sys/kernel/sched_ext").exists():
        r.append(("ok", "Scheduler", "sched_ext in the kernel (scx_lavd can run)"))
    else:
        r.append(("warn", "Scheduler", "no sched_ext: scx_lavd won't run (the CachyOS kernel has it)"))
    try:
        mod = smu_module()
        temp = mod.tctl()
        r.append(("ok" if temp < 70 else "warn", "Temperature",
                  f"{temp:.0f} °C idle" + ("" if temp < 70 else ": hot for idle, check the fan on the heatsink")))
        lay = mod.layout()
        r.append(("ok", "CPU layout", f"main thread {lay['main']}, other game threads "
                                      f"{mod.fmt_cpus(lay['core0'] + lay['rest'])}, render {mod.fmt_cpus(lay['gx'])}"))
    except Exception as e:  # noqa: BLE001 - shown as a warning, the rest still runs
        r.append(("warn", "Sensors", f"couldn't read the topology or k10temp: {e}"))
    if (HOME / ".var/app/com.valvesoftware.Steam").exists() and not (STEAM / "steamapps").exists():
        r.append(("fail", "Steam", "Flatpak Steam isn't supported: install the native steam package"))
    elif (STEAM / "steamapps").exists():
        r.append(("ok", "Steam", f"native, {STEAM}"))
    else:
        r.append(("fail", "Steam", f"not found at {STEAM}"))
    lib = game_library()
    r.append(("ok", "Elden Ring", f"installed ({lib})") if lib else ("fail", "Elden Ring", "not installed in Steam"))
    tag = proton_tag(STOCK)
    if not tag:
        r.append(("fail", "Proton", "proton-cachyos-slr isn't installed (the packages step installs it)"))
    elif tag == TESTED_PROTON:
        r.append(("ok", "Proton", f"proton-cachyos-slr {tag} (the tested version)"))
    else:
        r.append(("warn", "Proton", f"proton-cachyos-slr {tag}: untested (tested: {TESTED_PROTON}); the build "
                                    "refuses a mismatched result, so it's safe to try"))
    groups = run(["id", "-nG"]).stdout.split()
    if os.geteuid() == 0:
        r.append(("fail", "User", "run this as your normal user, not root (it asks for sudo itself)"))
    elif shutil.which("sudo") and ("wheel" in groups or "sudo" in groups):
        r.append(("ok", "User", f"{os.environ.get('USER', '?')} (sudo works through the wheel group)"))
    else:
        r.append(("warn", "User", "not in the wheel group: the system steps need sudo"))
    if not os.environ.get("XDG_RUNTIME_DIR"):
        r.append(("warn", "Session", "no systemd user session: the launcher's watcher falls back to setsid"))
    free = shutil.disk_usage(HOME).free / 2**30
    fs = run(["stat", "-f", "-c", "%T", str(HOME)]).stdout.strip()
    need = 1.5 if fs == "btrfs" else 3.5
    r.append(("ok" if free >= need else "warn", "Disk", f"{free:.0f} GB free in {HOME} ({fs}; the build needs "
                                                       f"~{need} GB)"))
    miss = missing_packages("run", "oc", "proton") + ([] if tag else ["proton-cachyos-slr"])
    r.append(("ok", "Packages", "all there") if not miss else
             ("warn", "Packages", "missing: " + " ".join(miss) + " (the packages step installs them)"))
    if game_running():
        r.append(("warn", "Elden Ring", "is running: quit it before installing"))
    legacy = Path("/usr/local/bin/er-smu").exists() and not MANIFEST.exists()
    if legacy:
        r.append(("info", "Old setup", "files from the research version found; install moves them aside"))
    return r


def show_checks(results):
    w = max(len(label) for _, label, _ in results)
    for level, label, detail in results:
        print(f"  {MARK[level]} {label:<{w}}  {dim(detail) if level in ('ok', 'info') else detail}")


# --- install steps -----------------------------------------------------------------------

def step_check(state):
    results = preflight()
    show_checks(results)
    fails = [r for r in results if r[0] == "fail"]
    if fails:
        print()
        say("fail", "Fix the ✗ items above first, then run ./elden-research install again.")
        return "failed"
    return "done"


def step_packages(state):
