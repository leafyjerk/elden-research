    · the patched Proton tool (proton-cachyos-slr-er), if you agree below
    · the launcher, settings and install state (and the logs and the Wine build cache, if you agree)
  The stock proton-cachyos-slr and your game and saves are not touched.""")
    if game_running():
        sys.exit("Quit Elden Ring first.")
    if not ask("Uninstall elden-research?", default=False):
        return
    if MANIFEST.exists():
        if not sudo_ready() or sudo_stream(["bash", str(LIB / "system-setup.sh"), "uninstall"]) != 0:
            say("fail", "The system part couldn't be removed (output above). Nothing else was changed.")
            return
        say("ok", "System part removed.")
    if TOOL.exists() and "er-wine" in (TOOL / "compatibilitytool.vdf").read_text(errors="replace"):
        tool, _ = steam_settings()
        if tool == TOOL_NAME:
            say("warn", "Elden Ring still uses the patched tool in Steam: switch it back (Compatibility tab).")
        if ask(f"Remove the patched Proton tool ({TOOL})?"):
            shutil.rmtree(TOOL)
            say("ok", "Patched Proton tool removed.")
    keep_logs = (DATA / "logs").exists() and not ask("Remove the game session logs too?", default=False)
    if DATA.exists():
        for p in DATA.iterdir():
            if not (keep_logs and p.name in ("logs", "saves")):
                shutil.rmtree(p) if p.is_dir() else p.unlink()
        say("ok", "Launcher removed" + (f" (logs kept in {DATA / 'logs'})" if keep_logs else "."))
    shutil.rmtree(CONFIG.parent, ignore_errors=True)
    shutil.rmtree(STATE.parent, ignore_errors=True)
    if CACHE.exists() and ask(f"Remove the Wine source/build cache ({CACHE}, ~500 MB)?"):
        shutil.rmtree(CACHE, ignore_errors=True)
    print(f"""
  {bold('In Steam:')} Elden Ring → Properties → General: clear the launch options;
  Compatibility: pick your previous Proton (e.g. proton-cachyos-slr). Reboot to get the
  boot-time defaults back.""")


def cmd_menu(args):
    banner()
    st = oc_state()
    installed = MANIFEST.exists() and LAUNCHER.exists()
    print(f"  {MARK['ok' if installed else 'info']} {'Installed' if installed else 'Not installed yet'}"
          f"   {MARK[oc_summary(st)[0]]} OC: {oc_summary(st)[1]}"
          f"   {MARK['ok' if tool_patched() else 'info']} Proton patches: {'built' if tool_patched() else 'not built'}")
    items = [("1", "Install / continue the install", cmd_install), ("2", "Status and last session", cmd_status),
             ("3", "Preflight checks (read-only)", cmd_check), ("4", "Overclock safety test", cmd_octest),
             ("5", "Build the patched Proton", cmd_proton), ("6", "Steam steps", cmd_steam),
             ("7", "Benchmark helpers", cmd_bench), ("8", "Uninstall", cmd_uninstall)]
    print()
    for key, text, _ in items:
        print(f"    {gold(key)}  {text}")
    print(f"    {gold('q')}  Quit\n")
    try:
        choice = input(f"  {amber('›')} ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return
    for key, _, fn in items:
        if choice == key:
            return fn([])


COMMANDS = {"install": cmd_install, "check": cmd_check, "status": cmd_status, "oc-test": cmd_octest,
            "oc": cmd_oc, "proton": cmd_proton, "steam": cmd_steam, "bench": cmd_bench,
            "uninstall": cmd_uninstall, "menu": cmd_menu}


def main():
    args = sys.argv[1:]
    if args and args[0] in ("-h", "--help", "help"):
        print(__doc__)
        return
    if os.geteuid() == 0:
        sys.exit("Run elden-research as your normal user, not with sudo: it asks for sudo itself when needed.")
    cmd = COMMANDS.get(args[0] if args else "menu")
    if not cmd:
        sys.exit(__doc__)
    try:
        cmd(args[1:])
    except KeyboardInterrupt:
        live_done()
        print()


if __name__ == "__main__":
    main()
