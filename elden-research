def frame_stats(csv_path):
    """MangoHud CSV -> avg FPS, median FPS, % of frames over 17.5 ms, worst frame, seconds."""
    rows = csv_path.read_text(errors="replace").splitlines()
    head = rows[2].split(",")
    ift, iel = head.index("frametime"), head.index("elapsed")
    ft, el = [], []
    for r in rows[3:]:
        f = r.split(",")
        try:
            ft.append(float(f[ift]))
            el.append(int(f[iel]))
        except (ValueError, IndexError):
            pass
    if len(ft) < 100:
        return None
    s = sorted(ft)
    return {"avg": len(ft) / (sum(ft) / 1000), "median": 1000 / s[len(s) // 2],
            "late": 100 * sum(x > 17.5 for x in ft) / len(ft), "worst": s[-1], "secs": (el[-1] - el[0]) / 1e9}


def last_session():
    log = DATA / "logs/launch.log"
    if not log.exists():
        return None
    text = log.read_text(errors="replace")
    starts = [m.start() for m in re.finditer(r"^=== \d{4}-\d\d-\d\d \d\d:\d\d:\d\d launch$", text, re.M)]
    if not starts:
        return None
    block = text[starts[-1]:]
    info = {"when": block.split("\n", 1)[0][4:-7], "lines": block.splitlines()}
    for key, pat in (("oc", r"^CPU OC (on|failed|: no).*"), ("guard", r".*thermal guard.*"),
                     ("smt", r"^CPU \d+ \(main thread's sibling\) offline"), ("scx", r"^scx_lavd started"),
                     ("patched", r"^ntdll\.so: has the event pool"), ("pool", r"event pool: .*"),
                     ("exited", r"^game exited"), ("pinned", r"^main thread -> .*"), ("proton", r"^proton: .*")):
        m = re.search(pat, block, re.M)
        info[key] = m[0].strip() if m else None
    csvs = sorted((DATA / "logs").glob("eldenring_*[0-9].csv"), key=lambda p: p.stat().st_mtime)
    info["csv"] = csvs[-1] if csvs else None
    return info


