            return "done"
    elif tool_patched():
        say("info", f"The stock Proton was updated ({proton_tag(TOOL)} → {tag}); the patched tool still works, "
                    "and a rebuild follows the update.")
    print(f"""  Builds Proton's ntdll.so (Wine's Unix side) with two patches for the game's main thread:
    {green('1.')} spin up to 20 µs before sleeping on a wineserver reply or a short wait
    {green('2.')} an event pool: a helper thread creates the ~3,600 events/s the main thread asks
       for, and closes them, so their wineserver round trips leave the main thread
  Only that one file changes, in a copy of proton-cachyos-slr called {TOOL_NAME};
  the stock tool is never touched. It downloads the matching Wine source (~400 MB) from
  CachyOS's GitHub, builds a stock and a patched ntdll.so, checks both against the shipped
  one (exports, libraries, protocol, syscall numbers) and smoke-tests the result.""")
    if tag != TESTED_PROTON:
        say("warn", f"{tag} is newer than the tested {TESTED_PROTON}.",
            "If the patch doesn't apply or a check fails, nothing is installed.")
    miss = missing_packages("proton")
    if miss:
        say("fail", "Missing packages: " + " ".join(miss), "(the packages step installs them)")
        return "failed"
    if not ask("Build it now (~10-20 min, mostly unattended)?"):
        say("skip", "Skipped: stock proton-cachyos-slr still works with everything else.")
        return "skipped"
    t0 = time.monotonic()
    code, lines = run_live(["bash", str(WINE / "build-er-wine.sh")], "building", build_parse)
    if code != 0 or not tool_patched():
        say("fail", "The build stopped:")
        for line in [l for l in lines if l.strip()][-12:]:
            print("    " + dim(line))
        print(f"    {dim('Logs: ' + str(CACHE / 'wine/build.log') + ' and install.log')}")
        return "failed"
    for line in lines:
        if re.match(r"(exports:|patched ntdll\.so: OK|installed:|Steam shows it as:|second run:)", line):
            say("ok", line)
    say("ok", f"Patched Proton ready in {mmss(time.monotonic() - t0)}: {tool_display_name()}")
    return "done"


