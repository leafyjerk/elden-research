def width():
    return max(60, min(shutil.get_terminal_size((80, 24)).columns, 100))


def vlen(s):
    return len(ANSI.sub("", s))


def fit(s, n):
    """Cuts s to n visible characters, keeping its color codes."""
    out, used = [], 0
    for part in re.split(r"(\033\[[0-9;]*m)", s):
        if ANSI.fullmatch(part):
            out.append(part)
        else:
            out.append(part[:max(0, n - used)])
            used += len(out[-1])
    return "".join(out) + ("\033[0m" if COLOR else "")


def banner():
    print()
    for word in ("ELDEN", "RESEARCH"):
        for row in range(6):
            line = "".join(FONT[ch][row] for ch in word)
            print("  " + paint(f"38;5;{GRADIENT[row]}", line))
    rule = "─" * 19
    print(f"  {dim(rule)} {amber('✦')} {dim(rule)} {amber('✦')} {dim(rule)}")
    print(f"  {gold('a locked 60 FPS for Elden Ring on the AMD BC-250')}  {dim('· CachyOS · v' + VERSION)}")
    print()


def header(title):
    print()
    print(f"  {amber('✦')} {bold(title)}")
    print("  " + dim("─" * (width() - 4)))


def bar(frac, n=24):
    full = max(0, min(n, round(frac * n)))
    return gold("█" * full) + dim("░" * (n - full))


def step_header(i, n, title):
    w = width()
    print()
    print(gold("━" * w))
    left = f" {bold(f'STEP {i}/{n}')} {dim('·')} {bold(title)}"
    right = f"{bar((i - 1) / n)} {round(100 * (i - 1) / n):3}% "
    print(left + " " * max(1, w - vlen(left) - vlen(right)) + right)
    print(gold("━" * w))


def say(level, text, detail=""):
    print(f"  {MARK[level]} {text}" + (f"  {dim(detail)}" if detail else ""))


def item(level, label, detail):
    """A status row: label column, then the detail (dim when it's fine)."""
    print(f"  {MARK[level]} {label:<19}{dim(detail) if level in ('ok', 'info') else detail}")


def note(text):
    for line in text.splitlines():
        print(f"    {dim(line)}" if line.strip() else "")


def live(text):
    if TTY:
        sys.stdout.write("\r\033[K" + fit(text, width() - 1))
        sys.stdout.flush()


def live_done():
    if TTY:
        sys.stdout.write("\r\033[K")
        sys.stdout.flush()


def mmss(s):
    s = int(s)
    return f"{s // 60}:{s % 60:02}"


def ask(question, default=True):
    if not sys.stdin.isatty():
        return default
    hint = "[Y/n]" if default else "[y/N]"
    while True:
        try:
            a = input(f"  {amber('?')} {question} {dim(hint)} ").strip().lower()
        except EOFError:
            return default
        if not a:
            return default
        if a in ("y", "yes"):
            return True
        if a in ("n", "no"):
            return False


def pause(text="Press Enter to continue"):
    if sys.stdin.isatty():
        try:
            input(f"  {dim(text)} ")
        except EOFError:
            pass


# --- helpers ---------------------------------------------------------------------------

def run(cmd, **kw):
    return subprocess.run(cmd, capture_output=True, text=True, **kw)


def sudo_ready():
    """Asks for the sudo password up front, so it doesn't interrupt a progress display."""
    if run(["sudo", "-n", "true"]).returncode == 0:
        return True
    print(f"  {dim('sudo asks for your password for this step:')}")
    return subprocess.run(["sudo", "-v"]).returncode == 0


def sudo_stream(args):
    """Runs a root command, printing its output indented. Returns its exit status."""
    p = subprocess.Popen(["sudo", *args], stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True)
    for line in p.stdout:
        print("    " + dim(line.rstrip()))
    return p.wait()


def run_live(cmd, title, parse=None, env=None):
    """Runs cmd with a spinner, the elapsed time and the latest output line (or what
    `parse` makes of each line). Returns (exit status, all output lines)."""
    lines, status = [], ""
    # The child appends through its own file description, so reading here never moves
    # the offset it writes at.
    with tempfile.NamedTemporaryFile("r") as out:
        with open(out.name, "a") as child_out:
            p = subprocess.Popen(cmd, stdout=child_out, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL, env=env)
        t0, pos, i = time.monotonic(), 0, 0
        while True:
            done = p.poll() is not None
            out.seek(pos)
            chunk = out.read()
            pos = out.tell()
            for line in chunk.splitlines():
                line = line.rstrip()
                lines.append(line)
                if line.strip():
                    status = parse(line, status) if parse else line
            if done:
                break
            live(f"  {amber(SPIN[i % len(SPIN)])} {title} {dim(mmss(time.monotonic() - t0))}  {status}")
            if not TTY and i % 150 == 0:
                print(f"  ... {title} {mmss(time.monotonic() - t0)} {ANSI.sub('', status)}", flush=True)
            i += 1
            time.sleep(0.12)
    live_done()
    return p.returncode, lines


